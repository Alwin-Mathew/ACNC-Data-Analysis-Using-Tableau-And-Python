      <column caption='State' datatype='string' name='[Calculation_1558808489213624323]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([State]) THEN &apos;Unknown&apos;&#13;&#10;ELSEIF LOWER([State]) = &apos;wa&apos; THEN &apos;WA&apos;&#13;&#10;ELSEIF LOWER([State]) = &apos;vic&apos; THEN &apos;VIC&apos;&#13;&#10;ELSEIF LOWER([State]) = &apos;tas&apos; THEN &apos;TAS&apos;&#13;&#10;ELSEIF LOWER([State]) = &apos;qld&apos; THEN &apos;QLD&apos;&#13;&#10;ELSEIF LOWER([State]) = &apos;act&apos; THEN &apos;ACT&apos;&#13;&#10;ELSEIF LOWER([State]) = &apos;nsw&apos; THEN &apos;NSW&apos;&#13;&#10;ELSEIF LOWER([State]) = &apos;nt&apos; THEN &apos;NT&apos;&#13;&#10;ELSEIF LOWER([State]) = &apos;sa&apos; THEN &apos;SA&apos;&#13;&#10;END' />
      </column>
      <column caption='Charity Size' datatype='string' name='[Calculation_1558808489229197316]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([charity size]) THEN&#13;&#10;    IF [total revenue] &lt; 250000 THEN &apos;Small&apos;&#13;&#10;    ELSEIF [total revenue] &lt; 1000000 THEN &apos;Medium&apos;&#13;&#10;    ELSE &apos;Large&apos;&#13;&#10;    END&#13;&#10;ELSE [charity size]&#13;&#10;END' />
      </column>
